# 파인튜닝 모델(wtgmate-parser)을 Ollama에 등록하는 Modelfile.
#
# 등록:
#   1) GGUF(wtgmate-parser.gguf, ~1.9GB, git 제외)를 이 파일이랑 같은 폴더에 둠 (Colab에서 생성).
#   2) ollama create wtgmate-parser -f Modelfile
#
# TEMPLATE는 채팅 래핑 없이 프롬프트 그대로 넘기는 raw passthrough.
# 학습을 텍스트 이어쓰기(alpaca_prompt)로 해서 추론도 같은 형식이어야 함.
# (main.py call_ollama가 raw=True로 부르는 거랑 짝)

FROM ./wtgmate-parser.gguf
TEMPLATE {{ .Prompt }}
PARAMETER num_ctx 2048
PARAMETER stop <|im_end|>
PARAMETER stop <|endoftext|>
PARAMETER temperature 0.1
