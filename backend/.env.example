# WTGMate 백엔드 환경변수 예시. 실제 값은 backend/.env에 넣는다(.env는 커밋 금지).
# 배포(EC2)에서는 .env 평문 대신 AWS SSM Parameter Store 등에서 주입 권장(DEPLOY.md 참고).

# --- 로컬 LLM(Ollama) ---
# Ollama 서버 주소와 등록된 모델명. 기본값으로도 로컬 동작.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=wtgmate-parser

# --- 지도/경로 API 키 ---
# Kakao REST 키(장소 검색·지오코딩·자동차 길찾기). 필수.
KAKAO_REST_API_KEY=
# Tmap(SK) 보행자 경로안내 앱키. 없으면 도보는 추정치로 폴백.
TMAP_APP_KEY=
# ODsay 대중교통 길찾기 인증키(무료 30회/일). 없으면 대중교통은 추정치로 폴백.
# ODsay '서버' 앱은 호출 서버의 공인 IP 등록이 필요(배포 시 EC2 IP).
ODSAY_API_KEY=

# --- CORS ---
# 허용할 프론트 오리진(콤마 구분). 배포 도메인을 넣는다. 미설정 시 전체 허용(*)=로컬 개발용.
# 예: ALLOWED_ORIGINS=https://wtgmate.example.com
ALLOWED_ORIGINS=*
