# WTGMate 프론트엔드 환경변수 예시. 실제 값은 frontend/.env에 넣는다(.env는 커밋 금지).
# Vite는 빌드 시점에 VITE_ 접두 변수만 번들에 주입한다.

# Kakao 지도 JS 키(지도 렌더링용). 필수. Kakao 콘솔에서 배포 도메인을 이 키의 플랫폼에 등록해야 지도가 뜬다.
VITE_KAKAO_JAVASCRIPT_KEY=

# 백엔드 API 베이스 URL.
#  - 로컬 개발: 비워두면 http://127.0.0.1:8000로 폴백.
#  - 배포(nginx가 같은 도메인에서 /api를 프록시): 빈 문자열("")로 두면 /api 상대경로로 호출(권장, CORS 불필요).
#  - 백엔드가 다른 도메인: 예) VITE_API_BASE_URL=https://api.wtgmate.example.com
VITE_API_BASE_URL=
